schema {{ schema_name }} {

    document {{ schema_name }} {

        field query type string {
            indexing: summary | attribute
            attribute: fast-search
        }

        field query_suffixes type array<string> {
            indexing: summary | attribute
            attribute: fast-search
        }

        field query_suffixes_index type array<string> {
            indexing: index
            index: enable-bm25
            stemming: none
            normalizing: none
        }

        field rank type double {
            indexing: summary | attribute
        }

    }

    fieldset default {
        fields: query_suffixes
    }

    rank-profile exact inherits default {
        first-phase {
            expression: attribute(rank)
        }
    }

    rank-profile fuzzy inherits default {
        first-phase {
            expression: attribute(rank) + bm25(query_suffixes_index)
        }
    }

}