# Versions of various components used in the project
TRITON_VERSION=25.08-py3
VESPA_VERSION=8.513.17

# Runtime configurations for tests
COMPOSE_PROFILES=cpu
VESPA_DISK_USAGE_LIMIT=0.75

HF_HUB_ENABLE_HF_TRANSFER=1
MARQO_ENABLE_BATCH_APIS=TRUE
MARQO_ENABLE_OPS_API=TRUE
MARQO_API_INFERENCE_CACHE_SIZE=0
MARQO_LOG_FORMAT=plain
MARQO_LOG_LEVEL=debug
MARQO_MAX_CPU_MODEL_MEMORY=10
MARQO_MAX_CUDA_MODEL_MEMORY=10
MARQO_MODELS_TO_PRELOAD=[]
MARQO_INDEX_DEPLOYMENT_LOCK_TIMEOUT=0
MARQO_REMOTE_INFERENCE_URL=http://ec2-54-221-251-8.compute-1.amazonaws.com:8884
VESPA_CONFIG_URL=http://localhost:19071
VESPA_DOCUMENT_URL=http://localhost:8080
VESPA_QUERY_URL=http://localhost:8080
ZOOKEEPER_HOSTS=localhost:2181